{
  "name": "@tgbotpress/plugin-collection",
  "version": "0.1.0",
  "type": "module",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./sweep": {
      "types": "./src/sweep.d.ts",
      "import": "./src/sweep.js"
    },
    "./sweep.js": {
      "types": "./src/sweep.d.ts",
      "import": "./src/sweep.js"
    }
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@tgbotpress/plugin-sdk": "^0.1.0"
  },
  "devDependencies": {
    "@tgbotpress/plugin-sdk": "file:../plugin-sdk"
  }
}
