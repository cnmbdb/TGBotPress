{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "react"],
    "noEmit": true
  },
  "include": [
    "src/*.source.ts",
    "src/admin-pages.ts",
    "src/admin-ui-runtime.ts",
    "src/admin-pages.*.tsx"
  ]
}
