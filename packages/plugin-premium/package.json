{
  "name": "@tgbotpress/plugin-premium",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "publishConfig": { "registry": "https://registry.npmjs.org" },
  "exports": {
    ".": { "types": "./src/index.d.ts", "import": "./src/index.js" },
    "./fulfillment": { "types": "./src/fulfillment.d.ts", "import": "./src/fulfillment.js" },
    "./purchases": { "types": "./src/purchases.d.ts", "import": "./src/purchases.js" },
    "./wallet-poll": { "types": "./src/wallet-poll.d.ts", "import": "./src/wallet-poll.js" },
    "./notifications": { "types": "./src/notifications.d.ts", "import": "./src/notifications.js" },
    "./admin-api": { "types": "./src/admin-api.d.ts", "import": "./src/admin-api.js" },
    "./tasks": { "types": "./src/tasks.d.ts", "import": "./src/tasks.js" },
    "./server": { "types": "./src/server.d.ts", "import": "./src/server.js" },
    "./admin-pages": { "types": "./src/admin-pages.d.ts", "import": "./src/admin-pages.js" }
  },
  "files": ["src", "migrations", "scripts", "tsconfig.json", "tsconfig.build.json"],
  "engines": { "node": ">=22" },
  "dependencies": { "zod": "^4.6.7" },
  "peerDependencies": {
    "@tanstack/react-query": ">=5",
    "lucide-react": ">=0.400.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": { "optional": true },
    "lucide-react": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.105.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "typescript": "^7.0.2"
  }
}
