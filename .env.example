# 复制为 .env 后替换为自己的随机值。
DB_PASSWORD=replace-with-a-strong-database-password
# 空数据库首次初始化时使用，至少 12 个字符，最多 72 字节。
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-admin-password
# 至少 32 个字符；部署后应妥善保存。
APP_KEY=replace-with-a-long-random-secret-at-least-32-characters
# 生产环境改为浏览器访问后台的实际地址。
PLATFORM_ORIGIN=http://127.0.0.1:8083
# 可选：指定生产镜像版本。
TGBOTPRESS_IMAGE=ghcr.io/cnmbdb/tgbot-ultra-tanstack:latest

# 应用及容器内数据库连接
APP_ENV=development
PLATFORM_AUTH_MODE=native
DB_DATABASE=tgbotpress
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=tgbotpress
REDIS_HOST=redis
REDIS_PORT=6379
PLATFORM_URL=http://127.0.0.1:8083
LEGACY_ORIGIN=http://127.0.0.1:8083
TELEGRAM_WEBHOOK_ORIGIN=http://127.0.0.1:8084
PLATFORM_TELEGRAM_ACTIONS=false
PLATFORM_TELEGRAM_UPDATE_DISPATCH_READY=false
PLATFORM_TELEGRAM_POLLING_ENABLED=false
PLATFORM_LEGACY_CACHE_REQUIRED=false
PLATFORM_PROCESS_MODE=all
PLATFORM_WORKER_ENABLED=1
TZ=Asia/Shanghai
